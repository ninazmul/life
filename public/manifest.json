      "purpose": "any maskable"
    },
    {
      "src": "/assets/images/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Home",
      "description": "Open Life dashboard",
      "url": "/",
      "icons": [{ "src": "/assets/images/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Secure Vault",
      "short_name": "Vault",
      "description": "Access encrypted vault items",
      "url": "/vault",
      "icons": [{ "src": "/assets/images/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Money",
      "short_name": "Money",
      "description": "Financial records & settlements",
      "url": "/money",
      "icons": [{ "src": "/assets/images/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "People",
      "short_name": "People",
      "description": "People directory & delegations",
      "url": "/people",
      "icons": [{ "src": "/assets/images/logo.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+life",
      "url": "/?q=%s"
    }
  ]
